# Copy to .env (local) or set these in your host's environment settings (production).
# Never commit real values. Variables marked [required] must be set in production.

# ─── Core ────────────────────────────────────────────────────────────────
# [required] PostgreSQL 14+ connection string.
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio?schema=public
# Direct (non-pooled) connection for `npm run db:migrate`, when DATABASE_URL goes through a transaction pooler.
# DIRECT_DATABASE_URL=
# Max connections per server process (default 10). Lower it on serverless hosts.
# DATABASE_POOL_MAX=10

# [required] Public origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [required] Signs preview links and other tokens. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to "false" to send `Disallow: /` in robots.txt (staging). Preview deployments on Vercel are never indexed.
# ALLOW_INDEXING=true

# ─── Media storage ───────────────────────────────────────────────────────
# local      → files on disk under LOCAL_UPLOAD_DIR, served and resized by /media/*
#              (needs a persistent volume in production)
# cloudinary → uploads go to Cloudinary and are delivered from its CDN
MEDIA_DRIVER=local
LOCAL_UPLOAD_DIR=./storage/uploads
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=studio

# ─── Email (contact brief notifications) ─────────────────────────────────
# Without SMTP_URL, new briefs are still stored in the admin inbox and the email is written to the server log.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM="Studio website <no-reply@example.com>"
# Where new briefs are sent. Defaults to the studio email set in Admin → Settings.
# CONTACT_NOTIFY_EMAIL=hello@example.com

# ─── First admin account (used by `npm run db:seed` and `npm run admin:create`) ───
ADMIN_EMAIL=admin@example.com
# Leave empty to be prompted by `npm run admin:create`. Remove from production env after first login.
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# Demo content: brand name used by the seed for the demo site (editable later in Admin → Settings).
# SEED_SITE_NAME=Halden
# SEED_FAST=1   # smaller demo images and shorter videos (CI)
# SEED_DEMO=false   # seed roles and the admin only, no demo content

# ─── Prisma ──────────────────────────────────────────────────────────────
# The client runs on the JS query compiler + pg driver adapter, so no native engine download is needed.
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# ─── Tests ───────────────────────────────────────────────────────────────
# Separate database; the unit DB tests and Playwright reset it on every run.
TEST_DATABASE_URL=postgresql://studio:studio@localhost:5432/studio_test?schema=public
# E2E_DATABASE_URL=            # overrides TEST_DATABASE_URL for Playwright
# E2E_PORT=3100
# E2E_SKIP_BUILD=1             # reuse the existing .next build and database
# PW_CHANNEL=chrome            # browser channel for Playwright ("chromium" for the bundled build)
